# ============================================================================
# IBRAHIMA TRAORE — EXECUTIVE WEBSITE CONFIGURATION (.env.example)
# Official Domain: https://ibrahimatraore.net
# Official Email:  ceo@ibrahimatraore.net
# Copy this file to .env on your Hostinger VPS (or .env.local for local dev)
# ============================================================================

# 1. CANONICAL PRODUCTION DOMAIN & PROTOCOL
# Used across canonical tags, hreflang annotations, XML sitemap, robots.txt,
# Open Graph metadata, and Schema.org JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=https://ibrahimatraore.net
NEXT_PUBLIC_ENFORCE_HTTPS=true
NEXT_PUBLIC_PREFERRED_HOST=ibrahimatraore.net

# 2. SEARCH ENGINE VERIFICATION TOKENS
# Add tokens from Google Search Console and Bing Webmaster Tools.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 3. EXECUTIVE CONTACT & SOCIAL CONFIGURATION
# Leave NEXT_PUBLIC_VERIFIED_EMAIL blank so the CEO email is not publicly scraped;
# all Contact Form submissions still route to CONTACT_RECIPIENT_EMAIL (ceo@ibrahimatraore.net).
NEXT_PUBLIC_VERIFIED_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# 4. CONTENT EXPANSION FEATURE FLAGS
NEXT_PUBLIC_ENABLE_INSIGHTS=false
NEXT_PUBLIC_ENABLE_CASE_STUDIES=false
NEXT_PUBLIC_PORTRAIT_PATH=/images/ibrahima-traore-desk-portrait.jpg

# 5. SERVER-SIDE ENQUIRY DELIVERY CONFIGURATION (ALL MESSAGES -> ceo@ibrahimatraore.net)
CONTACT_DELIVERY_ENABLED=true
CONTACT_SIMULATE_DELIVERY=true
CONTACT_RECIPIENT_EMAIL=ceo@ibrahimatraore.net
CONTACT_FROM_EMAIL=ceo@ibrahimatraore.net

# Provider options: "smtp" | "resend" | "sendgrid" | "webhook"
CONTACT_PROVIDER=smtp

# Option A: Hostinger Email / Titan Mail SMTP (Default for ceo@ibrahimatraore.net)
# Just fill in SMTP_PASS with your ceo@ibrahimatraore.net mailbox password on the VPS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ceo@ibrahimatraore.net
SMTP_PASS=

# Option B: Resend API (Alternative)
RESEND_API_KEY=

# Option C: SendGrid API (Alternative)
SENDGRID_API_KEY=

# Option D: Custom Webhook URL (Alternative)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
